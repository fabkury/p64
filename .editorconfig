root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hpp}]
indent_style = space
indent_size = 2

[*.{cmake,txt,yml,yaml,csv}]
indent_style = space
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
