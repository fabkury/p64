# The product firmware (firmware/): ESP-IDF build products; credentials must never be
# committed from either ESP-IDF folder.
firmware/build/
firmware/build_public/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.secrets
firmware/managed_components/
firmware/dependencies.lock.old
firmware/tests/host/build*/

# firmware/reference/ holds upstream clones kept locally (git-ignored, see
# firmware/README.md) and, tracked, the hardware test bed hardware-tests/ (the former
# firmware/, moved here on 2026-09-24) with its own ESP-IDF build products ignored.
firmware/reference/*
!firmware/reference/hardware-tests/
firmware/reference/hardware-tests/build/
firmware/reference/hardware-tests/sdkconfig
firmware/reference/hardware-tests/sdkconfig.old
firmware/reference/hardware-tests/sdkconfig.secrets
firmware/reference/hardware-tests/managed_components/
firmware/reference/hardware-tests/dependencies.lock.old
firmware/reference/hardware-tests/tools/gifcheck/build/

# The private area: a separate repository (github.com/fabkury/p64-private) mounted at
# firmware/private/. The public firmware builds with or without it (firmware/CMakeLists.txt);
# its contents are never committed to p64 (a local pre-commit hook refuses them too).
firmware/private/

# The concept video (docs/video/): build products and the rendered MP4s (docs/video/output/) are
# regenerated by make.ps1; the one exception is the v4 cut linked from the README, which is committed
docs/video/build/
docs/video/output/*.mp4
!docs/video/output/p64b-concept-v4.mp4

# Editors and OS
.vscode/
.idea/
.cache/
*.swp
Thumbs.db
.DS_Store
__pycache__/

# Private outreach log (posts, metrics, feedback); kept local on purpose
docs/outreach.md

# Phone originals of the photos under docs/images/photos/<date>/: full size, with their
# EXIF (location included) and the videos; the committed copies are downsized and stripped
docs/images/photos/originals/

# The intro animation gallery is generated by firmware/tools/render_intro.py (11 MB of GIFs)
docs/images/intro/
