# The product firmware (firmware/): ESP-IDF build products; credentials must never be
# committed from either ESP-IDF folder.
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.secrets
firmware/managed_components/
firmware/dependencies.lock.old
firmware/tests/host/build*/

# firmware/reference/ holds upstream clones kept locally (git-ignored, see
# firmware/README.md) and, tracked, the hardware test bed hardware-tests/ (the former
# firmware/, moved here on 2026-09-24) with its own ESP-IDF build products ignored.
firmware/reference/*
!firmware/reference/hardware-tests/
firmware/reference/hardware-tests/build/
firmware/reference/hardware-tests/sdkconfig
firmware/reference/hardware-tests/sdkconfig.old
firmware/reference/hardware-tests/sdkconfig.secrets
firmware/reference/hardware-tests/managed_components/
firmware/reference/hardware-tests/dependencies.lock.old
firmware/reference/hardware-tests/tools/gifcheck/build/

# Editors and OS
.vscode/
.idea/
.cache/
*.swp
Thumbs.db
.DS_Store
__pycache__/

# Private outreach log (posts, metrics, feedback); kept local on purpose
docs/outreach.md
