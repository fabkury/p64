# Copy this file to sdkconfig.secrets (git-ignored) and fill in your network.
# The project's CMakeLists.txt applies it on top of sdkconfig.defaults. As with any
# defaults file, a change here only reaches an existing generated sdkconfig after
# `idf.py menuconfig` or after deleting firmware/sdkconfig.
CONFIG_P64_WIFI_SSID="my-network"
CONFIG_P64_WIFI_PASSWORD="my-password"
